<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">SETUP_LOGIN</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://demo.dolibarr.org/user/logout.php<datalist></datalist></td><td></td></tr>
<tr><td>open</td><td>https://demo.dolibarr.org/public/demo/index.php<datalist></datalist></td><td></td></tr>
<tr><td>pause</td><td>1000<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=a1profdemoall<datalist></datalist></td><td></td></tr>
<tr><td>click</td><td>css=#a1profdemoall a.modulelineshow<datalist></datalist></td><td></td></tr>
<tr><td>pause</td><td>1000<datalist></datalist></td><td></td></tr>
<tr><td>waitForVisible</td><td>css=#formprofdemoall input[type=submit]<datalist></datalist></td><td></td></tr>
<tr><td>click</td><td>css=#formprofdemoall input[type=submit]<datalist></datalist></td><td></td></tr>
<tr><td>pause</td><td>1000<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=username<datalist></datalist></td><td></td></tr>
<tr><td>type</td><td>id=username<datalist></datalist></td><td>demo</td></tr>
<tr><td>type</td><td>id=password<datalist></datalist></td><td>demo</td></tr>
<tr><td>click</td><td>css=input.butActionLogin<datalist></datalist></td><td></td></tr>
<tr><td>pause</td><td>1000<datalist></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//a[contains(@href,'logout.php')]<datalist></datalist></td><td></td></tr>
<tr><td>verifyElementNotPresent</td><td>id=username<datalist></datalist></td><td></td></tr>
<tr><td>runScript</td><td>return String(Date.now()).slice(-6);<datalist></datalist></td><td>run</td></tr>
<tr><td>echo</td><td>RUN ID = ${run}<datalist></datalist></td><td></td></tr>
</tbody></table>
