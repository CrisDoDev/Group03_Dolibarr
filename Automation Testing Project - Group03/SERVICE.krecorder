</thead><tbody>
<tr><td>open</td><td>https://demo.dolibarr.org/user/logout.php</td><td></td></tr>
<tr><td>open</td><td>https://demo.dolibarr.org/public/demo/index.php</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=a1profdemoall</td><td></td></tr>
<tr><td>click</td><td>css=#a1profdemoall a.modulelineshow</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForVisible</td><td>css=#formprofdemoall input[type=submit]</td><td></td></tr>
<tr><td>click</td><td>css=#formprofdemoall input[type=submit]</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=username</td><td></td></tr>
<tr><td>type</td><td>id=username</td><td>demo</td></tr>
<tr><td>type</td><td>id=password</td><td>demo</td></tr>
<tr><td>click</td><td>css=input.butActionLogin</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//a[contains(@href,'logout.php')]</td><td></td></tr>
<tr><td>verifyElementNotPresent</td><td>id=username</td><td></td></tr>
<tr><td>runScript</td><td>return String(Date.now()).slice(-6);</td><td>run</td></tr>
<tr><td>echo</td><td>RUN ID = ${run}</td><td></td></tr>
</tbody></table>
