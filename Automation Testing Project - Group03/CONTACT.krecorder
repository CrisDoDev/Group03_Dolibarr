<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//a[contains(@href,'logout.php')]</td><td></td></tr>
<tr><td>verifyElementNotPresent</td><td>id=username</td><td></td></tr>
<tr><td>runScript</td><td>return String(Date.now()).slice(-6);</td><td>run</td></tr>
<tr><td>echo</td><td>RUN ID = ${run}</td><td></td></tr>
</tbody></table>
