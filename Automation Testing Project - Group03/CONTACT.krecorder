</thead><tbody>
<tr><td>open</td><td>https://demo.dolibarr.org/user/logout.php</td><td></td></tr>
<tr><td>open</td><td>https://demo.dolibarr.org/public/demo/index.php</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=a1profdemoall</td><td></td></tr>
<tr><td>click</td><td>css=#a1profdemoall a.modulelineshow</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
<tr><td>waitForVisible</td><td>css=#formprofdemoall input[type=submit]</td><td></td></tr>
<tr><td>click</td><td>css=#formprofdemoall input[type=submit]</td><td></td></tr>
<tr><td>pause</td><td>1000</td><td></td></tr>
